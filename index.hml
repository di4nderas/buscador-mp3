<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Buscador MP3</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: system-ui, sans-serif; background: #0f0f0f; color: #eee; min-height: 100vh; padding: 2rem 1rem; }
  h1 { text-align: center; font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem; color: #fff; }
  h1 span { color: #ff4444; }
  .search-row { display: flex; gap: 8px; max-width: 600px; margin: 0 auto 1.5rem; }
  input { flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: #eee; font-size: 15px; outline: none; }
  input:focus { border-color: #ff4444; }
  button { padding: 10px 18px; border-radius: 8px; border: none; background: #ff4444; color: #fff; font-size: 15px; cursor: pointer; font-weight: 500; }
  button:hover { background: #e03333; }
  #results { max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
  .card { background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 12px; display: flex; gap: 12px; padding: 10px; align-items: center; }
  .card img { width: 100px; height: 60px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .card-info { flex: 1; min-width: 0; }
  .card-title { font-size: 13px; font-weight: 500; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-ch { font-size: 12px; color: #888; margin-top: 3px; }
  .btn-dl { display: inline-block; margin-top: 8px; padding: 5px 12px; background: #ff4444; color: #fff; border-radius: 6px; text-decoration: none; font-size: 12px; font-weight: 500; }
  .btn-dl:hover { background: #e03333; }
  .msg { text-align: center; color: #888; padding: 2rem; font-size: 14px; }
  .error { color: #ff6666; }
</style>
</head>
<body>
<h1>Busca y <span>Descarga</span> MP3</h1>
<div class="search-row">
  <input type="text" id="q" placeholder="Busca una canción o artista..." />
  <button onclick="buscar()">Buscar</button>
</div>
<div id="results"><p class="msg">Escribe algo para buscar.</p></div>

<script>
async function buscar() {
  const q = document.getElementById('q').value.trim();
  if (!q) return;
  const el = document.getElementById('results');
  el.innerHTML = '<p class="msg">Buscando...</p>';

  try {
    const r = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
    const data = await r.json();

    if (!Array.isArray(data) || !data.length) {
      el.innerHTML = '<p class="msg error">Sin resultados. Intenta con otra búsqueda.</p>';
      return;
    }

    el.innerHTML = '';
    data.slice(0, 10).forEach(v => {
      const thumb = v.videoThumbnails?.find(t => t.quality === 'medium')?.url
                  || v.videoThumbnails?.[0]?.url || '';
      const div = document.createElement('div');
      div.className = 'card';
      div.innerHTML = `
        <img src="${thumb}" alt="" loading="lazy" />
        <div class="card-info">
          <div class="card-title">${v.title}</div>
          <div class="card-ch">${v.author}</div>
          <a class="btn-dl" href="https://ebressources.fr/dl/${v.videoId}" target="_blank" rel="noopener">⬇ Descargar</a>
        </div>`;
      el.appendChild(div);
    });
  } catch(e) {
    el.innerHTML = '<p class="msg error">Error al conectar. Intenta más tarde.</p>';
  }
}

document.getElementById('q').addEventListener('keydown', e => {
  if (e.key === 'Enter') buscar();
});
</script>
</body>
</html>
